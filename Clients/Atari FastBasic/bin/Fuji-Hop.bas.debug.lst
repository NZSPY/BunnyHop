000000r 3               KEY_J       = $01
000000r 3               KEY_K       = $05
000000r 3               KEY_L       = $00
000000r 3               KEY_M       = $25
000000r 3               KEY_N       = $23
000000r 3               KEY_O       = $08
000000r 3               KEY_P       = $0A
000000r 3               KEY_Q       = $2F
000000r 3               KEY_R       = $28
