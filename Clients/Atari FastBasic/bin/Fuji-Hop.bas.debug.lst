000000r 3               
000000r 3               PBI     = $D100         ;##rev2## parallel bus interface area
000000r 3               
000000r 3               ; Read Addresses
000000r 3               
000000r 3               PDVI    = $D1FF         ;##rev2## parallel device IRQ status
