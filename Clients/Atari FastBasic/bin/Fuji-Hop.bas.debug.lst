000000r 3               KEY_X       = $16
000000r 3               KEY_Y       = $2B
000000r 3               KEY_Z       = $17
000000r 3               
000000r 3               KEY_COMMA       = $20
000000r 3               KEY_PERIOD      = $22
000000r 3               KEY_SLASH       = $26
000000r 3               KEY_SEMICOLON   = $02
